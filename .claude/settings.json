{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "claude-mem@thedotmack": true
  },
  "hooks": {
    "PreCompact": [{
      "matcher": "",
      "hooks": [{ "command": "bd prime", "type": "command" }]
    }],
    "SessionStart": [{
      "matcher": "",
      "hooks": [{ "command": "bd prime", "type": "command" }]
    }]
  },
  "fileSuggestion": {
    "type": "command",
    "command": "jq -r '.query' | xargs -I{} sh -c 'rg --files | rg \"{}\" | head -n 20'"
  }
}